---
import SiteLayout from "@layouts/SiteLayout.astro";
import { getDictionary } from "@content/dictionary";
import type { SupportedLocale } from "@lib/locale";
import "@styles/inner-pages.css";

export const prerender = true;
export async function getStaticPaths() {
	return [{ params: { locale: "es" } }, { params: { locale: "en" } }];
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = getDictionary(locale);
const c = t.contact;
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
---

<SiteLayout title={`Numen Games — ${c.title}`} description={c.lead} locale={locale} path="/contacto">
	<section class="page-hero">
		<div class="container">
			<h1>{c.title}</h1>
			<p class="page-hero__lead measure">{c.lead}</p>
		</div>
	</section>

	<section class="section page-section">
		<div class="container contact-container">
			<form id="contact-form" class="contact-form" novalidate>
				<input type="hidden" name="access_key" value={web3FormsKey} />
				<input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />
				<input type="hidden" name="subject" value="Nueva consulta desde numen.games" />

				<div class="field">
					<label for="name">{c.fields.name}</label>
					<input id="name" name="name" type="text" required autocomplete="name" />
				</div>

				<div class="field">
					<label for="email">{c.fields.email}</label>
					<input id="email" name="email" type="email" required autocomplete="email" />
				</div>

				<div class="field">
					<label for="org">{c.fields.org}</label>
					<input id="org" name="organización_o_evento" type="text" required autocomplete="organization" />
				</div>

				<div class="field">
					<label for="goal">{c.fields.goal}</label>
					<textarea id="goal" name="qué_busca_conseguir" required rows="4"></textarea>
				</div>

				<fieldset class="field-group">
					<legend class="visually-hidden">
						{locale === "en" ? "Optional details" : "Datos opcionales"}
					</legend>
					<div class="field">
						<label for="date">{c.fields.dateOptional}</label>
						<input id="date" name="fecha" type="text" />
					</div>
					<div class="field">
						<label for="city">{c.fields.cityOptional}</label>
						<input id="city" name="ciudad" type="text" />
					</div>
					<div class="field">
						<label for="size">{c.fields.sizeOptional}</label>
						<input id="size" name="tamaño_aproximado" type="text" />
					</div>
					<div class="field">
						<label for="phone">{c.fields.phoneOptional}</label>
						<input id="phone" name="teléfono" type="tel" autocomplete="tel" />
					</div>
				</fieldset>

				<button type="submit" class="btn btn--accent" id="contact-submit">
					{c.submit}
				</button>

				<p id="contact-result" role="status" aria-live="polite" class="contact-result"></p>
			</form>

			<p class="page-note contact-alt">
				{c.emailAlt} <a href={`mailto:${t.footer.contactEmail}`}>{t.footer.contactEmail}</a>
			</p>
		</div>
	</section>
</SiteLayout>

<script define:vars={{ sendingText: c.sending, successText: c.success, errorText: c.error, submitText: c.submit }}>
	const form = document.getElementById("contact-form");
	const result = document.getElementById("contact-result");
	const submitBtn = document.getElementById("contact-submit");

	form.addEventListener("submit", async (event) => {
		event.preventDefault();

		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}

		submitBtn.disabled = true;
		submitBtn.textContent = sendingText;
		result.textContent = "";
		result.dataset.state = "";

		const formData = new FormData(form);
		const payload = Object.fromEntries(formData);

		try {
			const response = await fetch("https://api.web3forms.com/submit", {
				method: "POST",
				headers: { "Content-Type": "application/json", Accept: "application/json" },
				body: JSON.stringify(payload),
			});

			if (response.ok) {
				result.textContent = successText;
				result.dataset.state = "success";
				form.reset();
			} else {
				result.textContent = errorText;
				result.dataset.state = "error";
			}
		} catch (err) {
			result.textContent = errorText;
			result.dataset.state = "error";
		} finally {
			submitBtn.disabled = false;
			submitBtn.textContent = submitText;
		}
	});
</script>

<style>
	.contact-container {
		max-width: 640px;
		margin-inline: 0;
	}
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.field label {
		font-size: var(--text-xs);
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}
	.field input,
	.field textarea {
		background: var(--surface-raised);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		padding: var(--space-3) var(--space-4);
		color: var(--ink);
		font-size: var(--text-base);
		font-family: inherit;
	}
	.field input:focus,
	.field textarea:focus {
		outline: 2px solid var(--focus-ring);
		outline-offset: 1px;
		border-color: var(--focus-ring);
	}
	.field-group {
		border: 0;
		padding: 0;
		margin: 0;
		display: grid;
		gap: var(--space-4);
	}
	.contact-form > .btn {
		align-self: flex-start;
	}
	.contact-form > .btn:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}
	.contact-result {
		font-size: var(--text-sm);
		min-height: 1.5em;
	}
	.contact-result[data-state="success"] {
		color: var(--interactive);
	}
	.contact-result[data-state="error"] {
		color: var(--alerta, #df6a72);
	}
	.contact-alt {
		margin-top: var(--space-8);
	}
	.contact-alt a {
		color: var(--interactive);
	}

	@media (min-width: 640px) {
		.field-group {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>

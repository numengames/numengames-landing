---
// Deprecated (2026-09-11): legacy service detail pages (Engage/Training/
// Experience) retired as part of the pivot to live-event gamification
// experiences. Redirects to home regardless of slug.
import type { GetStaticPaths } from "astro";
import { getLocaleStaticPaths } from "../../../i18n";

export const getStaticPaths = (() => {
	const slugs = ["training", "experience", "engage"];
	const locales = getLocaleStaticPaths();

	return locales.flatMap(({ params: { locale } }) =>
		slugs.map((slug) => ({
			params: { locale, slug },
		})),
	);
}) satisfies GetStaticPaths;

return Astro.redirect("/", 302);
---
